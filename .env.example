# Server
PORT=8084
NODE_ENV=production

# CORS — comma-separated origins, or "*" to allow any (consent SDK is multi-tenant)
CORS_ORIGINS=*

# Concordium Verifier Service (Docker container, port 8000)
VERIFIER_SERVICE_URL=http://concordium-verifier:8000

# Concordium network: testnet | mainnet
CONCORDIUM_NETWORK=testnet

# Verification context (human-readable, shown to user in ID App)
DEFAULT_CONTEXT_STRING=Age and country verification for site access
DEFAULT_RESOURCE_ID=/

# Session TTL (seconds)
VERIFICATION_SESSION_TTL=300

# ─── AesirX Proof Service ────────────────────────────────────────────────
# Redis is the existing aesirx_redis container on the aesirx-scanner network.
# Set REDIS_PASSWORD to the same value aesirx_redis was started with.
REDIS_PASSWORD=
# External Docker network the redis container is attached to. Compose
# prefixes the network with the redis project's directory name — find it
# with: docker ps --format '{{.Names}}\t{{.Networks}}' | grep redis
REDIS_NETWORK=public_html_aesirx-scanner
# Override REDIS_URL only if you point at a different Redis. The default in
# docker-compose.yml is redis://:${REDIS_PASSWORD}@redis:6379
# REDIS_URL=
REDIS_KEY_PREFIX=aps

# Concordium account that signs proof anchoring transactions (base58 address +
# hex sign key — extract from keys/private.export with jq).
AESIRX_ACCOUNT_ADDRESS=
AESIRX_PRIVATE_KEY=
CONCORDIUM_NODE_HOST=grpc.testnet.concordium.com
CONCORDIUM_NODE_PORT=20000
CONCORDIUM_NODE_TLS=true

ANCHOR_FINALITY_TIMEOUT_MS=60000
HMAC_TIMESTAMP_SKEW_SEC=300
IDEMPOTENCY_TTL_SEC=86400
BATCH_WINDOW_SEC=300
MAX_LEAVES_PER_BATCH=1024
