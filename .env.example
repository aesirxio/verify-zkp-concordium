# Server
PORT=8084
NODE_ENV=production

# CORS — comma-separated origins, or "*" to allow any (consent SDK is multi-tenant)
CORS_ORIGINS=*

# Concordium Verifier Service (Docker container, port 8000)
VERIFIER_SERVICE_URL=http://concordium-verifier:8000

# Concordium network: testnet | mainnet
CONCORDIUM_NETWORK=testnet

# Verification context (human-readable, shown to user in ID App)
DEFAULT_CONTEXT_STRING=Age and country verification for site access
DEFAULT_RESOURCE_ID=/

# Session TTL (seconds)
VERIFICATION_SESSION_TTL=300
